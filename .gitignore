# Terraform: never commit state. It records your infrastructure and holds secrets.
*.tfstate
*.tfstate.*
.terraform/
tfplan
*.tfplan
generated.tf
crash.log
terraform.tfvars
# Override files: the first bootstrap run uses local_override.tf for a local backend.
override.tf
*_override.tf
# .terraform.lock.hcl IS committed: it pins provider versions for everyone.

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS
.DS_Store
